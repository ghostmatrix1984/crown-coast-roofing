# Canonical URL of the deployed site (used for canonicals, Open Graph, sitemap).
# Demo default in code is http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Optional: Formspree-style JSON endpoint that receives free-quote enquiries.
# Leave unset for demo/preview mode — the form then clearly reports that no
# enquiry was sent and nothing leaves the browser.
# QUOTE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
